# Facebook Configuration
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Archive Sources (comma-separated)
ARCHIVE_SOURCES=https://archive.org/details/david-rumsey-map-collection?page=3,https://archive.org/details/metropolitanmuseumofart-gallery?page=4,https://archive.org/details/propix?page=4,https://archive.org/details/clevelandart?page=2,https://publicdomainreview.org/collections/all/

# Posting Configuration
MIN_POST_INTERVAL_HOURS=4
MAX_POST_INTERVAL_HOURS=12
MAX_IMAGES_PER_POST=3

# Credits and Disclaimer
CREDIT_TEXT=Image Source: {source}
DISCLAIMER_TEXT=Disclaimer: This image is used for commercial purposes under public domain or Creative Commons license. Source attribution provided.

# PRO SCRAPER SETTINGS (Advanced Features)
USE_PRO_SCRAPER=true  # Set to false to use basic scraper
MAX_PAGES_PER_SOURCE=5  # How many pages to scrape per source (accesses thousands of images)

# Image Quality Thresholds (Pro Scraper)
MIN_IMAGE_WIDTH=800
MIN_IMAGE_HEIGHT=600
MIN_IMAGE_SIZE_KB=50
MAX_IMAGE_SIZE_MB=10

# ENTERPRISE FEATURES
# Content Filtering
USE_AI_CONTENT_FILTER=false  # Enable AI-based NSFW detection (requires external API)

# STRICT NSFW DETECTION (Facebook Policy Compliance)
NSFW_STRICT_MODE=true  # Enable strict mode - block even low-risk content
SKIN_DETECTION_THRESHOLD=0.15  # Skin ratio threshold (15% = block if more than 15% skin pixels)
BLOCK_ON_MEDIUM_RISK=true  # Block medium-risk content automatically
USE_AI_NSFW_DETECTION=false  # Enable AI-based NSFW detection (requires API key)

# NSFW Detection Configuration
# The system uses multi-layered detection:
# 1. URL pattern analysis
# 2. Text metadata keyword detection (with severity levels)
# 3. Image analysis (skin detection, aspect ratio, color distribution)
# 4. AI detection (optional, requires external API)
# 5. Facebook policy compliance check

# Notifications
DISCORD_WEBHOOK_URL=  # Discord webhook for notifications
SLACK_WEBHOOK_URL=  # Slack webhook for notifications
EMAIL_NOTIFICATIONS=false  # Enable email notifications
EMAIL_TO=  # Email address for notifications
SMTP_SERVER=smtp.gmail.com  # SMTP server
SMTP_PORT=587  # SMTP port
SMTP_USERNAME=  # SMTP username
SMTP_PASSWORD=  # SMTP password

# Health Monitoring
ALERT_WEBHOOK_URL=  # Webhook for health alerts

# Rate Limiting (requests per minute)
FACEBOOK_API_RATE_LIMIT=200
ARCHIVE_SCRAPE_RATE_LIMIT=30
OPENROUTER_API_RATE_LIMIT=20
